# The obs-plugintemplate CI scripts (zsh/bash under .github and build-aux) rely on
# LF line endings, so normalize the whole tree to LF regardless of the checkout OS.
* text=auto eol=lf

# Inno Setup language files carry their own encoding (some with a UTF-8 BOM); keep them
# byte-for-byte so ISCC reads them correctly — no line-ending normalization.
*.isl -text
